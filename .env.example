# ==============================================================================
# VoiCe — Environment Configuration Template
# ==============================================================================

# 1. Supabase (Database, Auth, Storage)
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." # Safe for client (restricted by RLS)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." # Server-only! NEVER expose to client

# 2. AI Providers (Server-side only — never expose to client)
# Anthropic Claude API (Claude 3.5 Sonnet for vision OCR, tone analysis, reply generation)
ANTHROPIC_API_KEY="sk-ant-api03-..."
# Fallback: OpenRouter API
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"
OPENAI_API_KEY="sk-proj-your-openai-key"
GEMINI_API_KEY="AIzaSy-your-gemini-key"

# 3. Google OAuth Credentials (Configured in Supabase Auth -> Providers -> Google)
# Authorized redirect URI in Google Cloud Console:
# https://your-project-ref.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-secret"

# 4. Cloudflare Pages & Functions Settings
ENVIRONMENT="production" # "development" | "production"
ALLOWED_ORIGIN="https://voice-ai.pages.dev"
RATE_LIMIT_MAX_PER_MINUTE="30"
