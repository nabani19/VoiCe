{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./mobile/src/*"]
    }
  },
  "include": [
    "mobile/src/**/*",
    "mobile/App.tsx",
    "web/functions/**/*"
  ],
  "exclude": ["node_modules", "dist", "build"]
}
